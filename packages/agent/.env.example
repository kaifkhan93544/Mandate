# Copy this file to packages/agent/.env (never commit .env!)
# Options: gemini (free AI Studio tier), ollama (local), mock (offline test)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# Get a free API key (no credit card) at https://aistudio.google.com/
GEMINI_API_KEY=replace-with-your-free-ai-studio-key

# Used only when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Safety controls
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
